{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/EventRegistration.Api", "--launch-profile", "http", "--", "--Email:Enabled=false", "--Viber:Enabled=false", "--Sms:Enabled=false"],
      "port": 5088
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/EventRegistration.Api", "--launch-profile", "http", "--", "--urls", "http://localhost:5090", "--Email:Enabled=false", "--Viber:Enabled=false", "--Sms:Enabled=false"],
      "port": 5090
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "frontend/web"],
      "port": 4200
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "frontend/web", "--", "--port", "4400", "--configuration", "alt"],
      "port": 4400
    },
    {
      "name": "face",
      "runtimeExecutable": "facerog-engine/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "facerog-engine", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
